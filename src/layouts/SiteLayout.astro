---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TunaVideo",
  description = "영상 경로를 기준으로 생성되는 영상 페이지",
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">TunaVideo</a>
      <span class="tagline">Simple video library</span>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    color: #172033;
    background: #f6f7fb;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1120px;
    margin: 0 auto;
    padding: 2rem 1.25rem 1rem;
  }

  .brand {
    color: #172033;
    font-size: 1.35rem;
    font-weight: 800;
    text-decoration: none;
  }

  .tagline {
    color: #6b7280;
    font-size: 0.9rem;
  }

  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 1rem 1.25rem 4rem;
  }

  @media (max-width: 600px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
