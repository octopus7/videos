---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getPublishedCollections } from "../../lib/videos";

export async function getStaticPaths() {
  const collections = await getPublishedCollections();

  return collections.map((collection) => ({
    params: { path: collection.slug },
    props: { collection },
  }));
}

const { collection } = Astro.props;
---

<SiteLayout title={`${collection.label} · TunaVideo`} description={`${collection.label} 영상 목록`}>
  <article class="collection-page">
    <a class="back-link" href="/">← 전체 목록</a>
    <p class="eyebrow">VIDEO COLLECTION</p>
    <h1>{collection.label}</h1>
    <p class="path">{collection.slug}</p>
    {collection.contentHtml && (
      <div class="page-content" set:html={collection.contentHtml}></div>
    )}

    <div class="grid">
      {collection.videos.map((video) => (
        <article class="card">
          <div class="thumbnail">
            <video
              src={video.assetUrl}
              controls
              preload="metadata"
              playsinline
            ></video>
          </div>
          <div class="card-body">
            <h2>{video.title}</h2>
            <p>{video.relativePath}</p>
          </div>
        </article>
      ))}
    </div>
  </article>
</SiteLayout>

<style>
  .collection-page {
    padding: 3rem 0;
  }

  .back-link {
    color: #5b5bd6;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .eyebrow {
    margin: 2.5rem 0 0.7rem;
    color: #5b5bd6;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    letter-spacing: -0.06em;
  }

  .path {
    margin: 0.75rem 0 2rem;
    color: #6b7280;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
  }

  .page-content {
    max-width: 720px;
    margin: 0 0 2rem;
    color: #4b5563;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .page-content :global(p) {
    margin: 0 0 1rem;
  }

  .page-content :global(h1),
  .page-content :global(h2),
  .page-content :global(h3) {
    margin: 1.25rem 0 0.5rem;
    color: #172033;
  }

  .page-content :global(ul),
  .page-content :global(ol) {
    padding-left: 1.4rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  .card {
    overflow: hidden;
    border: 1px solid #e3e6ef;
    border-radius: 1rem;
    background: white;
    box-shadow: 0 8px 24px rgb(23 32 51 / 5%);
  }

  .thumbnail {
    background: #111827;
  }

  .thumbnail video {
    display: block;
    width: 100%;
    height: auto;
  }

  .card-body {
    padding: 1rem;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
  }

  .card-body p {
    overflow: hidden;
    margin: 0.45rem 0 0;
    color: #6b7280;
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
