---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getPublishedCollections } from "../lib/videos";

const collections = await getPublishedCollections();
---

<SiteLayout title="TunaVideo" description="영상 페이지 목록">
  <section class="hero">
    <p class="eyebrow">VIDEO LIBRARY</p>
    <h1>영상 목록</h1>
    <p class="intro">공개된 영상 폴더를 선택해 영상을 확인하세요.</p>
  </section>

  {collections.length > 0 ? (
    <div class="grid">
      {collections.map((collection) => (
        <a class="folder-card" href={collection.pageUrl}>
          <div class="folder-icon" aria-hidden="true">▶</div>
          <div>
            <p class="folder-label">영상 페이지</p>
            <h2>{collection.label}</h2>
            {collection.contentHtml && (
              <div
                class="folder-description"
                set:html={collection.contentHtml}
              ></div>
            )}
            <p class="folder-count">{collection.videos.length}개 영상</p>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p class="empty">.published 파일이 있는 영상 폴더가 없습니다.</p>
  )}
</SiteLayout>

<style>
  .hero {
    padding: 3rem 0 2rem;
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    color: #5b5bd6;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    letter-spacing: -0.06em;
  }

  .intro {
    margin: 1rem 0 0;
    color: #6b7280;
    font-size: 1.1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  .folder-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 150px;
    padding: 1.5rem;
    border: 1px solid #e3e6ef;
    border-radius: 1rem;
    background: white;
    color: inherit;
    box-shadow: 0 8px 24px rgb(23 32 51 / 5%);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .folder-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgb(23 32 51 / 10%);
  }

  .folder-icon {
    display: grid;
    flex: 0 0 3.5rem;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    color: white;
    background: #5b5bd6;
    font-size: 1.1rem;
  }

  .folder-label {
    margin: 0 0 0.35rem;
    color: #6b7280;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .folder-count {
    margin: 0.5rem 0 0;
    color: #6b7280;
    font-size: 0.85rem;
  }

  .folder-description {
    margin-top: 0.55rem;
    color: #4b5563;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .folder-description :global(p) {
    margin: 0;
  }

  .folder-description :global(h1),
  .folder-description :global(h2),
  .folder-description :global(h3) {
    margin: 0;
    font-size: 0.95rem;
  }

  .empty {
    padding: 2rem;
    border: 1px dashed #cbd2e1;
    border-radius: 1rem;
    color: #6b7280;
    text-align: center;
  }
</style>
